# ── 비밀정보 — 절대 커밋 금지 ──────────────────────────────
# data.go.kr 오픈API 인증키
.env
.env.*
!.env.example

# ── 파이썬 ────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── BMAD 개인 설정 (설치본이 gitignore 를 전제로 함) ────────
_bmad/custom/config.user.toml

# ── 대용량 중간 산출물 (재생성 가능) ──────────────────────
# 원장 199MB — tools/backfill_ledger.py 로 재생성 (612콜, 10분)
data/raw/ledger_2010_2026.csv
data/raw/aux_train.csv
data/raw/aux_shoe.csv
# v2 model/sim (38MB) 은 팀 공유본이라 커밋한다. v1 은 폐기 예정.
# 학습셋 로컬 전체본 — 공유본은 dataset/v1/shards/*.csv.gz 만 커밋한다
# (통짜 gzip 이 107MB 로 GitHub 100MB 하드리밋 초과. train 만도 105MB)
dataset/v1/kra_ml_v1.csv
dataset/v1/kra_ml_v1.csv.gz
dataset/v1/kra_ml_v1.parquet
dataset/*/_sample_*
data/raw/pedigree_daily.log

# ── OS / 편집기 ───────────────────────────────────────────
Thumbs.db
.DS_Store

# 육종가 원본 xlsx (20개, 약 27MB) — data/raw/ebv_long.csv 로 파싱해 쓴다
data/raw/ebv/*.xlsx


experiments/out/

# ── 로컬 백업 (2026-09-07 2004 백필 작업) ─────────────────
# 원장 백업 190MB — 원본이 이미 무시 대상이고 backfill_ledger.py 로 재생성된다.
#   GitHub 100MB 하드리밋에도 걸린다.
data/raw/_backup_before_2004/
# 백필 전 데이터셋 스냅샷 62MB — 커밋된 dataset/v2 와 바이트 단위로 동일함을 확인했다.
#   복구: git checkout 7067458 -- dataset/v2
dataset/v2_before_2004/

# ── 2026-09-10 작업 ───────────────────────────────────────
# 9/11 예측용 임시 원장 (원장 + 출전표, 각 190MB) — predict_20260911.py 가 다시 만든다
data/raw/_pred_ledger_*.csv
# 2004~2009 확장 원장 255MB — 백필은 기각됐다(McNemar p=0.868). tools/backfill_ledger.py 로 재생성
data/raw/ledger_2004_2026.csv
# 2004 확장 빌드 백업 81MB — 기각된 구성이라 보관만
dataset/v2_2004ext/
# 누수 검증용 rev 산출물 — tools/build_extra_*.py 로 다시 만든다
dataset/v2/extra/*_911rev.parquet

# ── raceday.py 산출물 ─────────────────────────────────────
# 프레임(각 100MB+) · 모델(2MB) — raceday.py build / train 으로 다시 만든다
out/_frame_*.parquet
out/models/
# 예측·채점 기록은 작고 근거라서 커밋한다 (out/live_pred_*.csv, out/scored_*.csv)
